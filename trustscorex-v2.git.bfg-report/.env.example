# MongoDB Atlas connection string (free M0 cluster)
# Get this from Atlas: Database > Connect > Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/trustscorex?retryWrites=true&w=majority

# Any long random string - used to sign admin login tokens
JWT_SECRET=change-this-to-something-long-and-random

# Used once by /api/auth/setup to create the first admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

PORT=3000
